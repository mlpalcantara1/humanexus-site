# Cada ambiente usa valores, segredos, usuários e bancos próprios.
HUMANEXUS_ENVIRONMENT=desenvolvimento

# URL do núcleo usada somente no servidor Next.js. Nunca prefixar com NEXT_PUBLIC_.
HUMANEXUS_CORE_API_URL=http://127.0.0.1:8080

# Origem pública deste ambiente.
NEXT_PUBLIC_HUMANEXUS_APP_URL=http://localhost:3007

# Segredo usado somente no servidor para compatibilidade do convite.
HUMANEXUS_INVITE_SECRET=substitua-por-segredo-local-com-32-caracteres

# Recuperação local é proibida em homologação e produção.
HUMANEXUS_LOCAL_RECOVERY_SECRET=
