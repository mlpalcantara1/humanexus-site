# URL privada do núcleo usado pelo portal no ambiente correspondente.
# Em produção, use a URL interna do serviço; não exponha o token ao navegador.
HUMANEXUS_CORE_API_URL=https://api.institutohumanexus.com

# Destino público definitivo do botão do site para a plataforma principal.
NEXT_PUBLIC_HUMANEXUS_APP_URL=https://app.institutohumanexus.com

# Permanecem necessários somente para a Anamnese por convite já existente.
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/humanexus_local
HUMANEXUS_INVITE_SECRET=substitua-por-segredo-local-com-32-caracteres
